@model IEnumerable<WebApp_Tolmas.Models.Student>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Student Directory</h1>

    <!-- Render the data in a Bootstrap-styled HTML table -->
    <table class="table table-bordered table-striped mt-4">
        <thead class="thead-dark">
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Grade</th>
                <th>Class Name</th>
                <th>Subject</th>
                <th>School Name</th>
                <th>City</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any()) {
                foreach (var student in Model) {
                    <tr>
                        <td>@student.FirstName</td>
                        <td>@student.LastName</td>

                        <!-- Check if the student is assigned to a classroom before displaying -->
                        @if (student.Classroom != null) {
                            <td>@student.Classroom.GradeLevel</td>
                            <td>@student.Classroom.ClassName</td>
                            <td>@student.Classroom.Subject</td>

                            <!-- Check if the classroom is assigned to a school before displaying -->
                            @if (student.Classroom.School != null) {
                                <td>@student.Classroom.School.Name</td>
                                <td>@student.Classroom.School.City</td>
                            } else {
                                <td colspan="2" class="text-muted">No School Assigned</td>
                            }
                        } else {
                            <td colspan="5" class="text-muted">No Class Assigned</td>
                        }
                    </tr>
                }
            } else {
                <tr>
                    <td colspan="7" class="text-center">No students found in the database.</td>
                </tr>
            }
        </tbody>
    </table>
</div>